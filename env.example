# =============================================================================
# Bilibili Auto Transcript — 本地环境配置（示例）
# =============================================================================
# 复制此文件为 env.local 并修改为你自己的配置
#   cp env.example env.local
# env.local 不会被提交到 git（已在 .gitignore 中忽略）
# =============================================================================

# --- B站收藏夹 ---
# 收藏夹 ID，从 URL ?fid= 后面的数字获取
FAV_MEDIA_ID="your_fav_media_id"

# Cookie 文件（私有收藏夹需要）
# 公开收藏夹无需设置。如果你的收藏夹是私有的，可用以下命令导出 Cookie：
#   yt-dlp --cookies-from-browser chrome --cookies ./bili_cookies.txt \
#     --skip-download --print title "https://www.bilibili.com/video/BVxxx/"
# 然后在下方填入路径：
# BILI_COOKIE_FILE="./bili_cookies.txt"
BILI_COOKIE_FILE=""

# --- 路径配置 ---
# 转录结果输出目录（B站模式按 YYYY-MM/ 分目录，本地文件保存到 local/）
OUTPUT_DIR="$HOME/workspace/knowledge/bilibili"

# 下载音频的缓存目录（从B站下载视频音频时暂存，脚本退出时自动清理）
CACHE_DIR="./cache/audio"

# ASR 模型下载缓存目录（仅 Qwen3-ASR 从 HuggingFace 下载时使用）
MODEL_CACHE_DIR="./models"

# 已处理记录与状态文件目录
STATE_DIR="$HOME/.openclaw/workspace/.auto-transcript-state"

# EPUB 电子书输出目录
EPUB_OUTPUT_DIR="$HOME/workspace/knowledge/bilibili/epub"

# --- Conda 环境 ---
# 运行 Python 脚本使用的 conda 环境名
CONDA_ENV="course-whisper"

# --- 浏览器 Cookie ---
# 用于获取 B站 AI 字幕的浏览器类型
# macOS: chrome | chromium | edge | safari | firefox
# Linux/WSL: chromium | firefox | edge
BROWSER_TYPE="chrome"

# --- LLM 摘要生成（可选）---
# 设置后自动为转录结果生成结构化摘要 + 思维导图 + AI 校对
# 不设置则跳过所有 LLM 后处理
SUMMARY_API_KEY="your_api_key"

# LLM API 端点，兼容 OpenAI 格式（LM Studio / Ollama / vLLM 均可）
# 会自动补全 /chat/completions 路径
SUMMARY_API_URL="http://127.0.0.1:1234/v1"

# 摘要/导图/校对共用的模型名称
SUMMARY_MODEL="auto"

# 每次 LLM 调用的最大 token 数
SUMMARY_MAX_TOKENS="16000"

# --- LLM 超时 ---
# LLM API 读取超时（秒），默认 600 适用于本地模型长文本处理
LLM_TIMEOUT="600"

# --- LLM 重试 ---
# LLM 请求失败后最多重试次数。默认 2 表示最多请求 3 次。
LLM_MAX_RETRIES="2"

# LLM 重试基础等待秒数，按 1x/2x/4x 指数退避。
LLM_RETRY_DELAY="3"

# --- 校对领域 ---
# 逗号分隔的专有领域关键词，校对时提示 LLM 重点关注这些领域的术语
# 可选值: finance, computer, medical, legal, engineering
# 留空则使用默认（金融 + 计算机）
PROOFREAD_DOMAINS="finance,computer"

# --- 转录行为 ---
# 转录失败最大重试次数
MAX_RETRIES="2"

# 视频间延迟（秒），避免触发 B站风控
BATCH_DELAY="3"

# LLM 后处理冷却等待（秒），本地模型压力大，摘要/导图/校对之间散热用
COOLDOWN_DELAY="30"

# 繁体转简体（需要安装 opencc）
ENABLE_OPENCC="true"

# 是否在输出 Markdown 中展开显示完整原文（默认 false，折叠为 <details>）
INCLUDE_FULL_TEXT="false"

# --- ASR 引擎 ---
# 语音转文字引擎：qwen3 或 whisper
#   qwen3  - Qwen3-ASR（GPU 1.7B / CPU 0.6B，中文 CER ~3.8%）
#   whisper - Whisper large-v3-turbo（Apple MLX 加速，适合 M 系列芯片）
ASR_ENGINE="qwen3"

# 本地模型路径
# Qwen3 示例：ASR_LOCAL_MODEL="./models/Qwen3-ASR-1.7B"
# Whisper 示例：ASR_LOCAL_MODEL="/path/to/mlx-community/whisper-large-v3-turbo"
# 留空则自动从 HuggingFace 下载
ASR_LOCAL_MODEL=""

# 强制使用本地 ASR 转录，跳过 B站 CC/AI 字幕检测
FORCE_ASR="false"

# Qwen3-ASR 专用：Apple Silicon 上 MPS 可能内存超限（47GB），设为 true 强制 CPU
FORCE_ASR_CPU="false"

# Whisper 转录语言（zh, en, ja 等），留空自动检测。纯中文可设为 zh 提高准确率
ASR_LANGUAGE=""
